{
  "name": "privacy-gateway-demo",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "engines": {"node": "20.19.5", "npm": "10.8.2"},
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test tests/browser tests/accessibility",
    "test:visual": "playwright test tests/visual",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "capture": "npm run build && node scripts/capture-frames.mjs",
    "record:check": "npm run build && node scripts/check-recording-flow.mjs",
    "release:notices": "node scripts/make-third-party-notices.mjs",
    "release:manifest": "npm run release:notices && node scripts/make-release-manifest.mjs",
    "release:check": "node scripts/check-release.mjs && node scripts/check-copy.mjs && node scripts/check-bundle.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:browser && npm run test:visual && npm run record:check && npm run release:check"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "4.3.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "20.19.43",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "axe-core": "4.12.1",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.5",
    "typescript": "6.0.2",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
